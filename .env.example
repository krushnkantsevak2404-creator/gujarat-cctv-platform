# =================================================================
# Gujarat CCTV Intelligence Platform - Environment Configuration Template
# Gujarat Police Innovation Hackathon 2026
# Copy this file to '.env' in the project root and update values.
# NEVER commit the real '.env' file to GitHub!
# =================================================================

# -----------------------------------------------------------------
# 1. Application Metadata & Core API
# -----------------------------------------------------------------
PROJECT_NAME="Gujarat CCTV Intelligence Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api"

# -----------------------------------------------------------------
# 2. Backend Server Configuration
# -----------------------------------------------------------------
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# -----------------------------------------------------------------
# 3. PostgreSQL + PostGIS Database Configuration
# -----------------------------------------------------------------
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DB="gujarat_cctv_db"

# Optional Full Connection String (Overrides individual parameters above if set)
# DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/gujarat_cctv_db"

# -----------------------------------------------------------------
# 4. Storage & Video Upload Limits
# -----------------------------------------------------------------
MAX_VIDEO_UPLOAD_MB=500

# -----------------------------------------------------------------
# 5. AI Vehicle Detection & Tracking (YOLOv8 + ByteTrack)
# -----------------------------------------------------------------
YOLO_MODEL_NAME="yolov8n.pt"
YOLO_CONFIDENCE_THRESHOLD=0.35
DETECTION_FRAME_INTERVAL=2
TRACKER_TYPE="bytetrack.yaml"

# -----------------------------------------------------------------
# 6. ANPR & License Plate Recognition (EasyOCR)
# -----------------------------------------------------------------
ANPR_OCR_CONFIDENCE_THRESHOLD=0.30
ANPR_FRAME_INTERVAL=3
ANPR_MIN_PLATE_WIDTH=60
ANPR_MIN_PLATE_HEIGHT=18

# -----------------------------------------------------------------
# 7. Frontend Vite Configuration
# -----------------------------------------------------------------
VITE_API_BASE_URL="http://127.0.0.1:8000"
