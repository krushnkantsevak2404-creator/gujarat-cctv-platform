# =================================================================
# Gujarat CCTV Intelligence Platform - Environment Configuration Template
# Gujarat Police Innovation Hackathon 2026
# Copy this file to '.env' and update the values for your local setup.
# =================================================================

# Application Settings
PROJECT_NAME="Gujarat CCTV Intelligence Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api"

# Backend Server Configuration
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL + PostGIS)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DB="gujarat_cctv_db"

# Optional Full Database URL (If specified, overrides individual fields above)
# DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/gujarat_cctv_db"

# Frontend Configuration (for React / Vite)
VITE_API_BASE_URL="http://127.0.0.1:8000"
