# =================================================================
# Gujarat CCTV Intelligence Platform - Git Ignore Configuration
# Gujarat Police Innovation Hackathon 2026
# =================================================================

# -----------------------------------------------------------------
# 1. Environment & Secrets (NEVER COMMIT SENSITIVE CREDENTIALS)
# -----------------------------------------------------------------
.env
.env.*
.env.local
.env.*.local
!.env.example

# -----------------------------------------------------------------
# 2. Python Bytecode & Cache
# -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# -----------------------------------------------------------------
# 3. Python Virtual Environments
# -----------------------------------------------------------------
.venv/
venv/
ENV/
env/
venv*/
.venv*/

# -----------------------------------------------------------------
# 4. Node & Frontend Build Artifacts
# -----------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
frontend/dist/
frontend/dist-ssr/
frontend/node_modules/
dist/

# -----------------------------------------------------------------
# 5. Local Video Footage, Processed Clips & Plate Crops
# (Large binary CCTV files must NEVER be committed to Git)
# -----------------------------------------------------------------
storage/footage/*
!storage/footage/.gitkeep
storage/processed/*
!storage/processed/.gitkeep
storage/plate_crops/*
!storage/plate_crops/.gitkeep
storage/*.db
storage/*.sqlite
storage/*.sqlite3
storage/*.log

# CCTV Video File Formats
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.flv
*.wmv
*.m4v

# -----------------------------------------------------------------
# 6. AI Model Weights & Cache Files
# (Weights are auto-downloaded on first run; do not commit large binaries)
# -----------------------------------------------------------------
*.pt
*.pth
*.onnx
*.engine
*.bin
*.weights
ai/*.pt
ai/*.pth
ai/*.onnx
ai/*.engine
backend/*.pt
backend/*.pth
backend/*.onnx

# EasyOCR / PyTorch cache directories
.EasyOCR/
.cache/

# -----------------------------------------------------------------
# 7. IDE, Editor & OS System Files
# -----------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
